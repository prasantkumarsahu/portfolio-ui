---
import { getImage } from "astro:assets";
import profile from "../../assets/profile.jpg";
import { contactChannels, site } from "../../data/site";
import { roles } from "../../data/experience";
import { skillCategories } from "../../data/skills";

interface Props {
    title: string;
    description: string;
    /** Path of the 1200×630 social preview image */
    image?: string;
    noindex?: boolean;
}

const { title, description, image = "/og.png", noindex = false } = Astro.props;

// Absolute URLs need `site` (SITE_URL); without it, tags that require one are left out
// rather than pointing at localhost.
const base = Astro.site;
const canonical = base && new URL(Astro.url.pathname, base).href;
const imageUrl = base && new URL(image, base).href;
// The person's own photo for structured data (the og image is the generic preview card)
const photo = await getImage({ src: profile, width: 460, format: "jpg" });
const photoUrl = base && new URL(photo.src, base).href;

// Only link profiles that are filled in, not the placeholders
const sameAs = [
    site.githubUrl,
    ...contactChannels
        .filter((c) => c.icon === "linkedin" && c.href.includes("/in/"))
        .map((c) => c.href),
];

const currentRole = roles.find((role) => role.current);

const person = {
    "@type": "Person",
    "@id": base ? `${new URL("/", base).href}#person` : "#person",
    name: site.name,
    jobTitle: site.role,
    description: site.description,
    ...(base && { url: new URL("/", base).href, image: photoUrl }),
    address: {
        "@type": "PostalAddress",
        addressLocality: site.location.city,
        addressCountry: site.location.countryCode,
    },
    homeLocation: { "@type": "Place", name: `${site.location.city}, ${site.location.country}` },
    ...(currentRole && { worksFor: { "@type": "Organization", name: currentRole.company } }),
    knowsAbout: skillCategories.flatMap((category) => category.skills),
    sameAs,
};

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "ProfilePage",
            name: title,
            description,
            ...(canonical && { url: canonical }),
            mainEntity: person,
        },
        {
            "@type": "WebSite",
            name: site.name,
            ...(base && { url: new URL("/", base).href }),
            inLanguage: "en",
        },
    ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta
    name="robots"
    content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
/>
{canonical && <link rel="canonical" href={canonical} />}
{base && <link rel="sitemap" href="/sitemap.xml" />}

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="profile:first_name" content={site.name.split(" ")[0]} />
<meta property="profile:last_name" content={site.name.split(" ").at(-1)} />
{canonical && <meta property="og:url" content={canonical} />}
{
    imageUrl && (
        <>
            <meta property="og:image" content={imageUrl} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:alt" content={`${site.name} · ${site.role}`} />
        </>
    )
}

<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

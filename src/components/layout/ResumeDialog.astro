---
import { Download, ExternalLink, FileText, X } from "@lucide/astro";
import { site } from "../../data/site";
import Button from "../ui/Button.astro";

const fileName = `${site.name.replaceAll(" ", "_")}_Resume.pdf`;
---

<!-- Resume preview. Opened by any link with [data-resume-open], which still points at the
     PDF so it works without JS, on middle-click and in a new tab. -->
<dialog
    id="resume-dialog"
    aria-labelledby="resume-dialog-title"
    class="resume-dialog m-auto flex h-[min(92dvh,1100px)] w-[min(94vw,880px)] max-w-none flex-col overflow-hidden rounded-xl border border-line bg-surface p-0 text-ink shadow-[0_32px_80px_-24px_rgb(0_0_0/0.5)] not-open:hidden backdrop:bg-black/60 backdrop:backdrop-blur-sm"
>
    <header class="flex items-center gap-3 border-b border-line px-4 py-3 sm:px-5">
        <FileText size={18} class="shrink-0 text-muted" aria-hidden="true" />
        <h2 id="resume-dialog-title" class="min-w-0 flex-1 truncate text-sm font-medium">
            Resume · {site.name}
        </h2>
        <Button href={site.resumeUrl} download={fileName} size="md" class="h-9 px-3" aria-label="Download resume">
            <Download size={16} />
            <span class="hidden sm:inline">Download</span>
        </Button>
        <Button
            href={site.resumeUrl}
            target="_blank"
            rel="noopener"
            size="icon"
            class="size-9"
            aria-label="Open resume in a new tab"
            title="Open in a new tab"
        >
            <ExternalLink size={16} />
        </Button>
        <Button size="icon" class="size-9" data-resume-close aria-label="Close" title="Close (Esc)">
            <X size={18} />
        </Button>
    </header>

    <div class="relative flex-1 bg-subtle">
        <!-- src is set on first open so the PDF only loads when asked for -->
        <iframe
            data-resume-frame
            title={`Resume of ${site.name}`}
            class="absolute inset-0 size-full border-0"></iframe>

        <!-- Phones: Android Chrome downloads PDFs in frames and iOS shows them cramped, so
             hand off to the phone's own PDF viewer instead -->
        <div
            data-resume-fallback
            hidden
            class="absolute inset-0 flex flex-col items-center justify-center gap-5 p-8 text-center"
        >
            <span class="flex size-14 items-center justify-center rounded-2xl border border-line bg-surface">
                <FileText size={26} class="text-accent-ink" stroke-width={1.5} />
            </span>
            <div class="flex flex-col gap-2">
                <p class="text-lg font-medium">{site.name}</p>
                <p class="max-w-72 text-sm leading-[1.6] text-muted">
                    {site.role}. The resume opens in your phone’s PDF viewer.
                </p>
            </div>
            <div class="flex flex-wrap justify-center gap-3">
                <Button href={site.resumeUrl} target="_blank" rel="noopener" variant="primary">
                    Open resume <ExternalLink size={16} />
                </Button>
                <Button href={site.resumeUrl} download={fileName}>
                    Download <Download size={16} />
                </Button>
            </div>
        </div>
    </div>
</dialog>

<script>
    const dialog = document.querySelector<HTMLDialogElement>("#resume-dialog")!;
    const frame = dialog.querySelector<HTMLIFrameElement>("[data-resume-frame]")!;
    const fallback = dialog.querySelector<HTMLElement>("[data-resume-fallback]")!;

    const canShowPdf = navigator.pdfViewerEnabled !== false && !matchMedia("(pointer: coarse)").matches;

    document.querySelectorAll<HTMLAnchorElement>("a[data-resume-open]").forEach((link) => {
        link.addEventListener("click", (event) => {
            // Leave modified clicks (new tab, new window) to the browser
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
            event.preventDefault();

            if (canShowPdf) {
                if (!frame.src) frame.src = `${link.getAttribute("href")}#view=FitH&navpanes=0`;
            } else {
                frame.hidden = true;
                fallback.hidden = false;
            }
            dialog.showModal();
        });
    });

    dialog.querySelector("[data-resume-close]")!.addEventListener("click", () => dialog.close());

    // Close on a click on the backdrop (the dialog element itself, outside its content)
    dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
    });
</script>

---
import { Sparkles } from "@lucide/astro";
import { site } from "../../data/site";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import Nav from "./Nav.astro";
import ThemeToggle from "./ThemeToggle.astro";

const year = new Date().getFullYear();
---

<header
    data-header
    class="relative z-40 bg-canvas/85 backdrop-blur-md transition-[border-color,box-shadow] duration-300 md:sticky md:top-0 md:border-b md:border-transparent md:data-scrolled:border-line md:data-scrolled:shadow-[0_8px_24px_-16px_rgb(0_0_0/0.25)]"
>
    <!-- Reading progress, driven by scroll in CSS -->
    <div
        class="scroll-progress pointer-events-none absolute inset-x-0 bottom-0 hidden h-px bg-accent md:block"
        aria-hidden="true"
    ></div>
    <Container
        class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-5 py-5 sm:gap-y-6 sm:py-6 md:flex md:justify-between md:gap-6"
    >
        <a href="/" class="flex items-baseline gap-3 whitespace-nowrap">
            <span class="font-semibold text-ink">{site.name}</span>
            <span class="hidden text-[11px] text-muted lg:inline">/ Portfolio</span>
        </a>

        <Nav class="col-span-2 row-start-2" />

        <p class="row-start-3 text-xs whitespace-nowrap uppercase text-muted md:hidden">
            Portfolio / {year}
        </p>

        <div class="contents md:flex md:items-center md:gap-3">
            <div class="col-start-2 row-start-1 justify-self-end">
                <ThemeToggle />
            </div>
            <Button
                href="/#contact"
                class="col-start-2 row-start-3 justify-self-end"
            >
                Ask about me
                <Sparkles
                    size={16}
                    class="transition-transform duration-300 group-hover/btn:scale-110 group-hover/btn:rotate-12"
                />
            </Button>
        </div>
    </Container>
</header>

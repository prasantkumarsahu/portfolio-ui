---
import {
    ArrowRight,
    ArrowUpRight,
    Ban,
    CalendarDays,
    Check,
    Clock3,
    Database,
    Files,
    ScanText,
    Users,
} from "@lucide/astro";
import type { ProjectPreview } from "../../data/projects";

interface Props {
    kind: ProjectPreview;
    /** Fills the card height instead of the fixed 224px (featured cards) */
    tall?: boolean;
}

const { kind, tall = false } = Astro.props;

const pipeline = [
    { name: "Documents", Icon: Files },
    { name: "Extract", Icon: ScanText },
    { name: "Structured data", Icon: Database },
];

const parts = [
    { name: "Housing", active: false },
    { name: "Drive unit", active: true },
    { name: "Base plate", active: false },
];

const tiles = [
    { name: "Team directory", Icon: Users },
    { name: "Time off", Icon: CalendarDays },
    { name: "Attendance", Icon: Clock3 },
];

// Bar heights (px) from the design, the last bar is highlighted
const bars = [40, 60, 48, 82, 68, 92, 78, 110];

// Kalinga sample adapted from the kalinga-lang README
const kalingaSource = [
    [["kw", "class "], ["ty", "Dog"], ["", " : "], ["ty", "Animal"], ["", " {"]],
    [["", "    "], ["kw", "override fn "], ["", "sound() -> "], ["ty", "str"], ["", " {"]],
    [["", "        "], ["kw", "return "], ["str", '"woof"']],
    [["", "    }"]],
    [["", "}"]],
    [["kw", "fn "], ["", "main() {"]],
    [["", "    println("], ["ty", "Dog"], ["", "("], ["str", '"Rex"'], ["", ").show())"]],
    [["", "}"]],
];
const tokenColor: Record<string, string> = { kw: "text-accent-ink", ty: "text-ink font-medium", str: "text-muted", "": "text-ink" };
const compileSteps = ["main.kl", "Rust", "rustc -O", "native"];

// DocMind: question, cited answer and the retrieval steps behind it
const ragSteps = ["Upload", "Embed", "Retrieve", "Answer"];

// pg-insight-mcp tool calls; writes never reach the database
const toolCalls = [
    { tool: "run_query", sql: "SELECT status, count(*) FROM orders", result: "4 rows", ok: true },
    { tool: "explain_query", sql: "… WHERE customer_id = 7", result: "Index Scan", ok: true },
    { tool: "run_query", sql: "DELETE FROM orders", result: "rejected", ok: false },
];
const mcpSteps = ["MCP client", "SQL guard", "READ ONLY", "Postgres"];

// Assembly layers move apart on card hover, outer layers furthest
const layerSpread = [
    "group-hover:-translate-y-1.5",
    "group-hover:-translate-y-0.5",
    "group-hover:translate-y-0.5",
    "group-hover:translate-y-1.5",
];

const label = "text-[10px] uppercase text-muted";
const box = "rounded-lg border border-line bg-surface";
---

<div
    class:list={[
        "flex flex-col gap-4 overflow-hidden rounded-lg bg-subtle p-5 sm:p-8",
        tall ? "min-h-56 lg:h-full" : "h-56",
    ]}
    aria-hidden="true"
>
    {
        kind === "compiler" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>Compiler / Pipeline</span>
                    <span class="font-mono text-[10px] text-muted">kalinga build</span>
                </div>
                {/* Keep everything inside <pre> on one line: whitespace there renders literally */}
                <pre class:list={[box, "flex-1 overflow-hidden p-4 font-mono text-[11px] leading-[1.7] sm:text-xs"]}><code>{kalingaSource.map((line, i) => <span class="block">{line.map(([type, text]) => <span class={tokenColor[type]}>{text}</span>)}{i === kalingaSource.length - 1 && <span class="ml-1 inline-block h-3 w-1.5 translate-y-0.5 bg-accent motion-safe:animate-blink" />}</span>)}</code></pre>
                <p class="flex flex-wrap items-center gap-2 font-mono text-[10px] text-muted">
                    {compileSteps.map((step, i) => (
                        <>
                            <span class:list={[i === compileSteps.length - 1 && "text-ink"]}>{step}</span>
                            {i < compileSteps.length - 1 && <ArrowRight size={10} />}
                        </>
                    ))}
                </p>
            </>
        )
    }

    {
        kind === "document" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>Document pipeline</span>
                    <span class="flex items-center gap-1 text-[10px] text-muted">
                        <span class="size-1 rounded-full bg-ink motion-safe:animate-pulse" />
                        Processed
                    </span>
                </div>
                <div class="flex flex-1 items-center gap-2 sm:gap-4">
                    {pipeline.map(({ name, Icon }, i) => (
                        <>
                            <div
                                class:list={[box, "flex h-26 min-w-0 flex-1 flex-col items-center justify-center gap-3 px-2 text-center transition-[translate,border-color] duration-500 ease-out group-hover:-translate-y-1 group-hover:border-accent/40"]}
                                style={`transition-delay: ${i * 80}ms`}
                            >
                                <Icon size={22} class="text-ink" stroke-width={1.5} />
                                <span class="text-[11px] text-ink">{name}</span>
                            </div>
                            {i < pipeline.length - 1 && <ArrowRight size={12} class="shrink-0 text-muted" />}
                        </>
                    ))}
                </div>
                <p class="flex items-center gap-2 text-[10px] uppercase text-muted">
                    PDF / Image <ArrowRight size={10} /> Extract <ArrowRight size={10} /> Validate
                </p>
            </>
        )
    }

    {
        kind === "assembly" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>Assembly / Explorer</span>
                    <span class="flex items-center gap-1 text-[10px] text-muted">
                        Isometric <ArrowUpRight size={10} />
                    </span>
                </div>
                <div class="flex min-w-0 flex-1 items-center gap-4 sm:gap-6">
                    <ul class="flex w-24 shrink-0 flex-col gap-3 sm:w-32">
                        {parts.map((part) => (
                            <li class:list={["flex items-center gap-2 text-[10px]", part.active ? "text-ink" : "text-muted"]}>
                                <span class:list={["size-1.25 rounded-full", part.active ? "bg-ink" : "border border-muted"]} />
                                {part.name}
                            </li>
                        ))}
                    </ul>
                    <svg viewBox="0 0 240 140" class="h-auto max-h-35 w-full max-w-60 min-w-0 text-muted" fill="none" stroke="currentColor" stroke-width="1">
                        {[0, 1, 2, 3].map((i) => {
                            const y = 18 + i * 26;
                            return (
                                <g
                                    class:list={["transition-transform duration-500 ease-out", layerSpread[i]]}
                                    stroke={i === 1 ? "var(--ink)" : undefined}
                                >
                                    <path d={`M120 ${y} L220 ${y + 26} L120 ${y + 52} L20 ${y + 26} Z`} fill="var(--subtle)" />
                                    <path d={`M20 ${y + 26} v6 L120 ${y + 58} L220 ${y + 32} v-6`} />
                                    <path d={`M120 ${y + 52} v6`} />
                                </g>
                            );
                        })}
                    </svg>
                </div>
            </>
        )
    }

    {
        kind === "people" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>People / Overview</span>
                    <span class="text-[10px] text-muted">Workspace preview</span>
                </div>
                <div class="grid grid-cols-3 gap-3">
                    {tiles.map(({ name, Icon }, i) => (
                        <div
                            class:list={[box, "flex min-h-16.75 min-w-0 flex-col justify-between gap-2 p-3 transition-[translate,border-color] duration-500 ease-out group-hover:-translate-y-1 group-hover:border-accent/40"]}
                            style={`transition-delay: ${i * 80}ms`}
                        >
                            <Icon size={18} class="text-ink" stroke-width={1.5} />
                            <span class="text-[11px] leading-tight text-ink">{name}</span>
                        </div>
                    ))}
                </div>
                <div class="flex items-center gap-3">
                    <span class="size-5 shrink-0 rounded-full bg-line" />
                    <span class="h-0.5 w-24 rounded-full bg-line" />
                    <span class="h-0.5 w-12 rounded-full bg-line" />
                </div>
            </>
        )
    }

    {
        kind === "rag" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>Retrieval / Chat</span>
                    <span class="flex items-center gap-1 text-[10px] text-muted">
                        <span class="size-1 rounded-full bg-ink motion-safe:animate-pulse" />
                        Streaming
                    </span>
                </div>
                <div class="flex min-w-0 flex-1 flex-col justify-center gap-2">
                    <p class="max-w-[80%] self-end rounded-lg bg-ink px-3 py-1.5 text-[11px] text-canvas transition-transform duration-500 ease-out group-hover:-translate-y-0.5">
                        How much notice do I need to give?
                    </p>
                    <div class:list={[box, "flex max-w-[90%] flex-col gap-1.5 px-3 py-2 transition-[translate,border-color] duration-500 ease-out group-hover:-translate-y-0.5 group-hover:border-accent/40"]} style="transition-delay: 80ms">
                        <p class="text-[11px] text-ink">
                            60 days, in writing
                            <span class="ml-1 rounded-sm bg-accent/10 px-1 font-mono text-[9px] text-accent-ink">1</span>
                        </p>
                        <p class="flex min-w-0 items-center gap-1.5 text-[10px] text-muted">
                            <Files size={10} class="shrink-0" />
                            <span class="truncate">acme-handbook.md · p. 3</span>
                        </p>
                    </div>
                </div>
                <p class="flex flex-wrap items-center gap-2 text-[10px] uppercase text-muted">
                    {ragSteps.map((step, i) => (
                        <>
                            {step}
                            {i < ragSteps.length - 1 && <ArrowRight size={10} />}
                        </>
                    ))}
                </p>
            </>
        )
    }

    {
        kind === "mcp" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>MCP / Tools</span>
                    <span class="font-mono text-[10px] text-muted">read-only</span>
                </div>
                <ul class:list={[box, "flex min-w-0 flex-1 flex-col justify-center gap-2 px-3 py-2 font-mono text-[10px] sm:text-[11px]"]}>
                    {toolCalls.map((call, i) => (
                        <li
                            class="flex min-w-0 items-center gap-2 transition-transform duration-500 ease-out group-hover:translate-x-1"
                            style={`transition-delay: ${i * 80}ms`}
                        >
                            <span class="shrink-0 text-accent-ink">{call.tool}</span>
                            <span class="min-w-0 flex-1 truncate text-muted">{call.sql}</span>
                            <span class:list={["flex shrink-0 items-center gap-1", call.ok ? "text-ink" : "text-muted"]}>
                                {call.ok ? <Check size={11} /> : <Ban size={11} />}
                                {call.result}
                            </span>
                        </li>
                    ))}
                </ul>
                <p class="flex flex-wrap items-center gap-2 font-mono text-[10px] text-muted">
                    {mcpSteps.map((step, i) => (
                        <>
                            <span class:list={[i === mcpSteps.length - 1 && "text-ink"]}>{step}</span>
                            {i < mcpSteps.length - 1 && <ArrowRight size={10} />}
                        </>
                    ))}
                </p>
            </>
        )
    }

    {
        kind === "reporting" && (
            <>
                <div class="flex items-center justify-between">
                    <span class={label}>Fund / Reporting</span>
                    <span class="text-[10px] text-muted">FY 2026</span>
                </div>
                <div class="flex h-30 items-end gap-2 sm:gap-4">
                    {bars.map((height, i) => (
                        <span
                            class:list={["reveal-grow flex-1", i === bars.length - 1 ? "bg-ink" : "bg-line"]}
                            style={`height: ${height}px; --grow-i: ${i}`}
                        />
                    ))}
                </div>
                <div class="flex justify-between text-[10px] text-muted">
                    <span>Q1</span>
                    <span>Q2</span>
                    <span>Q3</span>
                    <span>Q4 · illustrative</span>
                </div>
            </>
        )
    }
</div>

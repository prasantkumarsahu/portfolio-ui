---
import Eyebrow from "./Eyebrow.astro";

interface Props {
    index: string;
    eyebrow: string;
    title: string;
    description?: string;
    headingId?: string;
}

const { index, eyebrow, title, description, headingId } = Astro.props;
---

<div class="flex flex-col gap-4" data-reveal>
    <Eyebrow>{index} / {eyebrow}</Eyebrow>
    <div
        class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
    >
        <h2
            id={headingId}
            class="max-w-172.5 text-[28px] font-medium leading-[1.2] text-ink sm:text-4xl"
        >
            {title}
        </h2>
        {
            description && (
                <p class="text-sm leading-[1.6] text-muted lg:w-90 lg:shrink-0">
                    {description}
                </p>
            )
        }
    </div>
</div>

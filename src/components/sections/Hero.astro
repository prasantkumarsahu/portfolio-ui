---
import { ArrowDown, Download, MapPin } from "@lucide/astro";
import { Image } from "astro:assets";
import dotRow from "../../assets/dot-row.svg";
import profile from "../../assets/profile.jpg";
import { availability, site } from "../../data/site";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section aria-labelledby="hero-title" class="relative overflow-hidden">
    <Container class="relative flex flex-col gap-10 pt-12 pb-14 lg:pt-22">
        <!-- Decorative dot texture: the Figma asset used as a mask so it follows the theme.
             Rows drift in alternating directions with a staggered brightness wave; the
             container's edge fade hides dots entering and leaving. -->
        <div
            class="pointer-events-none absolute -top-3 right-6 flex w-40 flex-col gap-6 opacity-70 motion-safe:animate-fade-up mask-[linear-gradient(to_right,transparent,black_18%,black_82%,transparent)] sm:w-65.5 lg:top-16 lg:right-6"
            style="animation-delay: 300ms"
            aria-hidden="true"
        >
            {
                Array.from({ length: 10 }, (_, row) => (
                    <div
                        class="h-0.5 w-full bg-dot motion-safe:animate-dots"
                        style={[
                            `mask: url(${dotRow.src}) 0 0 / 262px 2px repeat-x`,
                            `-webkit-mask: url(${dotRow.src}) 0 0 / 262px 2px repeat-x`,
                            `animation-direction: ${row % 2 ? "reverse" : "normal"}, normal`,
                            `animation-delay: ${-row * 1.7}s, ${-row * 0.9}s`,
                        ].join("; ")}
                    />
                ))
            }
        </div>

        <div
            class="relative grid gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-10 lg:gap-16"
        >
            <div class="flex flex-col gap-10">
                <div
                    class="relative flex flex-wrap items-center gap-x-5 gap-y-3 motion-safe:animate-fade-up"
                >
                    <p
                        class="flex items-center gap-2 text-[11px] font-medium uppercase text-muted"
                    >
                        <span class="relative flex size-1.5 shrink-0">
                            <span
                                class="absolute inset-0 rounded-full bg-ink opacity-40 motion-safe:animate-ping"
                            ></span>
                            <span class="relative size-1.5 rounded-full bg-ink"></span>
                        </span>
                        {site.eyebrow}
                    </p>
                    <a
                        href="/#contact"
                        class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs text-ink transition-colors duration-300 hover:border-emerald-500/50"
                    >
                        <span
                            class="relative flex size-1.5 shrink-0"
                            aria-hidden="true"
                        >
                            <span
                                class="absolute inset-0 rounded-full bg-emerald-500 opacity-60 motion-safe:animate-ping"
                            ></span>
                            <span class="relative size-1.5 rounded-full bg-emerald-500"
                            ></span>
                        </span>
                        {availability.badge}
                    </a>
                </div>

                <div class="relative flex max-w-210 flex-col gap-6">
                    <h1
                        id="hero-title"
                        class="text-4xl font-medium leading-[1.08] text-ink motion-safe:animate-fade-up min-[360px]:text-[40px] sm:text-5xl lg:text-[64px]"
                        style="animation-delay: 80ms"
                    >
                        <span class="sr-only">{site.name}, </span>{site.role}
                    </h1>
                    <p
                        class="max-w-162.5 text-[17px] leading-[1.65] text-muted motion-safe:animate-fade-up"
                        style="animation-delay: 180ms"
                    >
                        {site.tagline}
                    </p>
                    <div
                        class="flex flex-wrap gap-3 pt-2 motion-safe:animate-fade-up"
                        style="animation-delay: 280ms"
                    >
                        <Button href="#projects" variant="primary" size="lg">
                            View projects
                            <ArrowDown
                                size={16}
                                class="transition-transform duration-300 group-hover/btn:translate-y-0.5"
                            />
                        </Button>
                        <Button href={site.resumeUrl} size="lg" download>
                            Download resume
                            <Download
                                size={16}
                                class="hidden transition-transform duration-300 group-hover/btn:translate-y-0.5 sm:block"
                            />
                        </Button>
                    </div>
                </div>
            </div>

            <!-- Portrait with location; first on phones, right column on desktop -->
            <figure
                class="relative order-first justify-self-start motion-safe:animate-fade-up md:order-0 md:justify-self-end"
                style="animation-delay: 200ms"
            >
                <div
                    class="group relative size-28 overflow-hidden rounded-2xl border border-line bg-subtle shadow-[0_24px_60px_-30px_rgb(0_0_0/0.45)] sm:size-40 md:size-48 lg:size-72 lg:rounded-3xl"
                >
                    <Image
                        src={profile}
                        alt={`Portrait of ${site.name}`}
                        widths={[160, 320, 460]}
                        sizes="(min-width: 1024px) 288px, (min-width: 768px) 192px, (min-width: 640px) 160px, 112px"
                        loading="eager"
                        fetchpriority="high"
                        class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    />
                </div>
                <figcaption
                    class="absolute -bottom-3 left-1/2 inline-flex -translate-x-1/2 items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1.5 text-xs whitespace-nowrap text-ink shadow-sm"
                >
                    <MapPin size={12} class="text-accent-ink" aria-hidden="true" />
                    {site.location.city}, {site.location.country}
                </figcaption>
            </figure>
        </div>

        <div
            class="flex flex-col gap-6 pt-8 motion-safe:animate-fade-up"
            style="animation-delay: 400ms"
        >
            <hr class="border-line" />
            <div class="flex items-center justify-between gap-6">
                <div class="flex flex-col gap-1">
                    <p class="text-[28px] font-medium text-ink">
                        {site.stats.value}
                    </p>
                    <p class="text-xs text-muted">{site.stats.label}</p>
                </div>
                <ul
                    class="flex flex-col items-end gap-1 text-right text-xs text-muted"
                >
                    {site.stats.focus.map((item) => <li>{item}</li>)}
                </ul>
            </div>
        </div>
    </Container>
</section>

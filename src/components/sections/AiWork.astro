---
import { ArrowRight, Cpu, Database, Plug, Workflow } from "@lucide/astro";
import { aiExplorations } from "../../data/ai";
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const icons = { workflow: Workflow, cpu: Cpu, database: Database, plug: Plug };
---

<section id="ai" aria-labelledby="ai-title" class="border-t border-line">
    <Container class="flex flex-col gap-10 py-16 lg:py-22">
        <SectionHeader
            index="04"
            eyebrow="Beyond the application"
            title="AI and intelligent systems"
            description="Generative AI I build into enterprise document workflows at IBM."
            headingId="ai-title"
        />

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
            {
                aiExplorations.map((item, index) => {
                    const Icon = icons[item.icon];
                    return (
                        <article
                            data-reveal
                            data-spotlight
                            style={`--reveal-i: ${index}`}
                            class="group relative flex flex-col gap-6 rounded-xl border border-line bg-surface p-6 transition-[translate,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:border-accent/60 hover:shadow-[0_16px_40px_-20px_rgb(0_0_0/0.3)]"
                        >
                            <div class="flex items-center justify-between">
                                <span class="flex size-10 items-center justify-center rounded-lg bg-subtle text-ink transition-colors duration-300 group-hover:bg-accent/10 group-hover:text-accent-ink">
                                    <Icon
                                        size={20}
                                        stroke-width={1.75}
                                        class="transition-transform duration-500 ease-out group-hover:scale-110"
                                    />
                                </span>
                                <span class="text-[10px] uppercase text-muted">In production</span>
                            </div>

                            <div class="flex flex-col gap-3">
                                <p class="text-[10px] font-medium uppercase text-muted">{item.label}</p>
                                <h3 class="text-[22px] font-medium text-ink">{item.title}</h3>
                                <p class="text-base leading-[1.65] text-muted lg:text-[17px]">
                                    {item.description}
                                </p>
                            </div>

                            <ol class="mt-auto flex items-center justify-between border-t border-line pt-4 text-[11px] text-muted" aria-label="Concept flow">
                                {item.flow.map((stage, i) => (
                                    <li class="flex items-center gap-2">
                                        {stage}
                                        {i < item.flow.length - 1 && (
                                            <ArrowRight
                                                size={12}
                                                aria-hidden="true"
                                                class="transition-transform duration-300 group-hover:translate-x-0.5"
                                                style={`transition-delay: ${i * 90}ms`}
                                            />
                                        )}
                                    </li>
                                ))}
                            </ol>
                        </article>
                    );
                })
            }
        </div>
    </Container>
</section>

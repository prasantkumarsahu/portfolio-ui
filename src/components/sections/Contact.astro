---
import { ArrowUpRight, Mail, MapPin } from "@lucide/astro";
import { availability, contactChannels, site } from "../../data/site";
import BrandIcon from "../ui/BrandIcon.astro";
import Container from "../ui/Container.astro";
import Eyebrow from "../ui/Eyebrow.astro";
---

<section id="contact" aria-labelledby="contact-title" class="border-t border-line">
    <Container
        class="flex flex-col gap-12 pt-16 pb-12 lg:flex-row lg:justify-between lg:pt-22 lg:pb-16"
    >
        <div class="flex max-w-156 flex-col gap-6" data-reveal>
            <Eyebrow>06 / Contact</Eyebrow>
            <h2
                id="contact-title"
                class="text-[36px] font-medium leading-[1.12] text-ink sm:text-5xl"
            >
                Let’s build something together
            </h2>
            <p class="text-[17px] leading-[1.65] text-muted">
                Have a system to build or a problem to untangle? Let’s start a conversation.
            </p>
            <p class="flex items-start gap-2.5 text-sm leading-[1.6] text-ink">
                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></span>
                {availability.detail}
            </p>
            <p class="flex items-center gap-2.5 text-sm text-muted">
                <MapPin size={14} class="shrink-0 text-accent-ink" aria-hidden="true" />
                Based in {site.location.city}, {site.location.country}
            </p>
        </div>

        <div class="flex flex-col gap-6 lg:w-96" data-reveal style="--reveal-i: 1">
            <p class="text-[10px] uppercase text-muted">Get in touch</p>
            <ul class="flex flex-col gap-4">
                {
                    contactChannels.map((channel) => (
                        <li>
                            <a
                                href={channel.href}
                                class="group -mx-3 flex items-center gap-4 rounded-lg px-3 py-2 transition-colors duration-300 hover:bg-subtle"
                                {...(channel.href.startsWith("http") && { target: "_blank", rel: "noopener noreferrer" })}
                            >
                                <span class="text-muted">
                                    {channel.icon === "mail" ? (
                                        <Mail size={18} />
                                    ) : (
                                        <BrandIcon name={channel.icon} />
                                    )}
                                </span>
                                <span class="flex flex-1 flex-col">
                                    <span class="text-[10px] text-muted">{channel.label}</span>
                                    <span class="text-sm text-accent-ink group-hover:underline">
                                        {channel.value}
                                    </span>
                                </span>
                                <ArrowUpRight
                                    size={16}
                                    class="text-accent-ink transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                                />
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </Container>
</section>

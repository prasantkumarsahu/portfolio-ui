---
import {
    ArrowUpRight,
    CircleDot,
    FolderGit2,
    GitCommitHorizontal,
    GitFork,
    GitPullRequest,
    Star,
    Tag,
} from "@lucide/astro";
import { site } from "../../data/site";
import { getGitHubData, type ActivityItem } from "../../lib/github";
import BrandIcon from "../ui/BrandIcon.astro";
import Container from "../ui/Container.astro";
import SectionHeader from "../ui/SectionHeader.astro";

const data = await getGitHubData(site.githubUsername);

const levelClass = ["bg-gh-0", "bg-gh-1", "bg-gh-2", "bg-gh-3", "bg-gh-4"];
const activityIcon: Record<ActivityItem["kind"], typeof GitCommitHorizontal> = {
    push: GitCommitHorizontal,
    create: FolderGit2,
    pr: GitPullRequest,
    issue: CircleDot,
    release: Tag,
    star: Star,
    fork: GitFork,
    other: GitCommitHorizontal,
};

const fmt = (iso: string, opts: Intl.DateTimeFormatOptions) =>
    new Date(iso.length === 10 ? `${iso}T00:00:00Z` : iso).toLocaleDateString("en-GB", { ...opts, timeZone: "UTC" });

// A month label sits over the first week whose first day starts a new month
const monthLabels = data.weeks.map((week, i) => {
    const first = week.find(Boolean);
    const prev = data.weeks[i - 1]?.find(Boolean);
    if (!first || i === 0) return "";
    return first.date.slice(5, 7) !== prev?.date.slice(5, 7) ? fmt(first.date, { month: "short" }) : "";
});

const tooltip = (count: number, date: string) =>
    `${count === 0 ? "No" : count} contribution${count === 1 ? "" : "s"} on ${fmt(date, { day: "numeric", month: "short", year: "numeric" })}`;

const stats = [
    { label: "Active days", value: data.activeDays },
    { label: "Longest streak", value: `${data.longestStreak} day${data.longestStreak === 1 ? "" : "s"}` },
    ...(data.publicRepos !== null ? [{ label: "Public repos", value: data.publicRepos }] : []),
];
---

<section id="github" aria-labelledby="github-title" class="border-t border-line">
    <Container class="flex flex-col gap-10 py-16 lg:py-22">
        <SectionHeader
            index="05"
            eyebrow="Open source"
            title="Building in public."
            description="Contributions and recent activity from GitHub, refreshed every day."
            headingId="github-title"
        />

        <div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
            <!-- Contribution graph -->
            <div
                data-reveal
                class="flex min-w-0 flex-col gap-5 rounded-xl border border-line bg-surface p-5 sm:p-6"
            >
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <p class="text-sm text-ink">
                        <span class="text-lg font-medium">{data.total.toLocaleString("en-US")}</span>{" "}
                        contributions in the last year
                    </p>
                    <a
                        href={data.profileUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group inline-flex items-center gap-1.5 text-xs text-accent-ink hover:underline"
                    >
                        <BrandIcon name="github" size={14} />
                        @{data.username}
                        <ArrowUpRight
                            size={12}
                            class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                        />
                    </a>
                </div>

                {
                    data.weeks.length ? (
                        <div class="overflow-x-auto pb-1" data-scroll-end>
                            <div class="inline-flex flex-col gap-1.5 text-[10px] text-muted">
                                <div class="flex gap-0.75 pl-8" aria-hidden="true">
                                    {monthLabels.map((label) => (
                                        <span class="w-2.75 shrink-0 overflow-visible whitespace-nowrap">{label}</span>
                                    ))}
                                </div>
                                <div class="flex gap-2">
                                    <div class="grid w-6 grid-rows-7 gap-0.75 leading-2.75" aria-hidden="true">
                                        <span />
                                        <span>Mon</span>
                                        <span />
                                        <span>Wed</span>
                                        <span />
                                        <span>Fri</span>
                                        <span />
                                    </div>
                                    <div
                                        class="grid grid-flow-col grid-rows-7 gap-0.75"
                                        role="img"
                                        aria-label={`${data.total} contributions in the last year`}
                                    >
                                        {data.weeks.map((week, c) =>
                                            week.map((day) =>
                                                day ? (
                                                    <span
                                                        class:list={[
                                                            "reveal-cell size-2.75 rounded-xs outline outline-black/5 -outline-offset-1 transition-[scale] duration-150 hover:scale-125 dark:outline-white/5",
                                                            levelClass[day.level],
                                                        ]}
                                                        style={`--c: ${c}`}
                                                        title={tooltip(day.count, day.date)}
                                                    />
                                                ) : (
                                                    <span class="size-2.75" />
                                                ),
                                            ),
                                        )}
                                    </div>
                                </div>
                                <div class="flex items-center justify-end gap-1 pt-1" aria-hidden="true">
                                    Less
                                    {levelClass.map((cls) => (
                                        <span class:list={["size-2.75 rounded-xs outline outline-black/5 -outline-offset-1 dark:outline-white/5", cls]} />
                                    ))}
                                    More
                                </div>
                            </div>
                        </div>
                    ) : (
                        <p class="text-sm text-muted">
                            The contribution graph couldn’t be loaded right now. See it on
                            <a href={data.profileUrl} class="text-accent-ink hover:underline">GitHub</a>.
                        </p>
                    )
                }

                <dl class="mt-auto grid grid-cols-3 gap-4 border-t border-line pt-4">
                    {
                        stats.map((stat) => (
                            <div class="flex flex-col gap-1">
                                <dt class="text-[10px] uppercase text-muted">{stat.label}</dt>
                                <dd class="text-lg font-medium text-ink">{stat.value}</dd>
                            </div>
                        ))
                    }
                </dl>
            </div>

            <!-- Recent activity -->
            <div
                data-reveal
                style="--reveal-i: 1"
                class="flex min-w-0 flex-col gap-4 rounded-xl border border-line bg-surface p-5 sm:p-6"
            >
                <p class="text-[10px] uppercase text-muted">Recent activity</p>
                {
                    data.activity.length ? (
                        <ol class="relative flex flex-col gap-4 before:absolute before:top-2 before:bottom-2 before:left-2.75 before:w-px before:bg-line">
                            {data.activity.map((item) => {
                                const Icon = activityIcon[item.kind];
                                return (
                                    <li class="relative flex gap-3">
                                        <span class="relative flex size-6 shrink-0 items-center justify-center rounded-full border border-line bg-surface text-muted">
                                            <Icon size={12} />
                                        </span>
                                        <div class="flex min-w-0 flex-col gap-0.5">
                                            {item.url ? (
                                                <a
                                                    href={item.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="truncate text-sm text-ink hover:text-accent-ink hover:underline"
                                                    title={item.text}
                                                >
                                                    {item.text}
                                                </a>
                                            ) : (
                                                <p class="truncate text-sm text-ink" title={item.text}>
                                                    {item.text}
                                                </p>
                                            )}
                                            <p class="text-xs text-muted">
                                                <a
                                                    href={item.repoUrl}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="text-accent-ink hover:underline"
                                                >
                                                    {item.repo}
                                                </a>
                                                {" · "}
                                                <time datetime={item.date}>{fmt(item.date, { day: "numeric", month: "short" })}</time>
                                            </p>
                                        </div>
                                    </li>
                                );
                            })}
                        </ol>
                    ) : (
                        <p class="text-sm text-muted">No recent public activity.</p>
                    )
                }
            </div>
        </div>
    </Container>
</section>

<script>
    // Like GitHub: on narrow screens, open the graph at the most recent weeks
    document.querySelectorAll<HTMLElement>("[data-scroll-end]").forEach((el) => {
        el.scrollLeft = el.scrollWidth;
    });
</script>

---
import "../styles/global.css";

import Analytics from "@vercel/analytics/astro";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Seo from "../components/layout/Seo.astro";
import { site } from "../data/site";

interface Props {
    title?: string;
    description?: string;
    noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <Seo title={title} description={description} noindex={noindex} />
        <!-- Vercel Web Analytics: page views; only reports on the Vercel deployment -->
        <Analytics />
        <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
        <!-- Profile-photo icons: .ico (16/32/48) for legacy, PNG for modern browsers, square for iOS -->
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <link rel="icon" type="image/png" href="/icon.png" sizes="192x192" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
        />
        <!-- Apply the saved or system theme before first paint to avoid a flash -->
        <script is:inline>
            (() => {
                let theme = null;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}
                const dark = theme ? theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
                document.documentElement.classList.toggle("dark", dark);
                // Enables scroll-reveal styles; without JS, content simply shows
                document.documentElement.classList.add("js");
            })();
        </script>
    </head>
    <body id="top">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-sm"
        >
            Skip to content
        </a>
        <Header />
        <main id="main">
            <slot />
        </main>
        <Footer />
        <script>
            import "../scripts/motion";
        </script>
    </body>
</html>
